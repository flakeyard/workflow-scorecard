{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>flakeyard/renovate-config//internal/workflow#v0.2.0"],
  "packageRules": [
    {
      "description": "The product workflow (FY-0007, FY-0030)",
      "matchFileNames": [".github/workflows/scorecard.yaml"],
      "semanticCommitType": "fix"
    },
    {
      "description": "The flake only checks and tests this repository; consumers do not receive it (FY-0007)",
      "matchFileNames": ["flake.nix", "flake.lock", "nix/**"],
      "semanticCommitType": "ci"
    }
  ]
}
